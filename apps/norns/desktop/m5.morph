# m5 — iterate on m4 from the blind test: happy read as "sleepy" (positive valence was
# squinting eyes + shrinking mouth). Fixes: eyes track arousal harder (sleepy stays
# closed / excited opens), happy is brighter (less squint), the mouth OPENS into a smile
# on positive valence (pressed/closed on sadness), cheek raise stronger. Head-on-readable
# valence (mouth open + cheek), since the side-view mouth rotation barely reads front-on.
body scale=0.82 @sx=1.15
  head oy=1.25 scale=1.85
    crown ox=-0.035 oy=0.32 scale=1.18575
    muzzle ox=0.5 oy=-0.29 scale=0.4866 @sy=1.0135
      mouth ox=0.25 oy=-0.32 scale=0.64885 @sx=0.7873 @sy=0.32 @sz=1.1411 @asy=0.35 @vsy=0.16 @vrot=14 @vdy=0.06
    face_sym mirX=1
      eye ox=0.385 oy=0.175 scale=0.6636 @z=0.639 @rot=0.18 @vsy=-0.03 @asy=0.14
        iris ox=0.14 scale=0.82585 @z=0.003
          pupil ox=0.07 oy=0.005 scale=0.8996
        upperlid ox=-0.075 oy=0.075 scale=1.0412 @sx=0.9961 @sy=0.9961 @z=0.003 @ady=0.22 @ddy=-0.18 @vdy=0.06
      brow ox=0.365 oy=0.405 scale=0.55 @sx=0.825 @sy=0.3465 @z=0.441 @sz=0.8308 @rot=12.96 @ady=0.16 @ddy=-0.2 @drot=-16
      cheek ox=0.365 oy=-0.035 scale=0.54855 @sy=0.9961 @z=0.582 @vdy=0.2
      ear ox=-0.575 oy=0.375 scale=0.3627 mirX=1 @sy=1.2716 @z=1.056 @rot=-11.16 @sx=0.5611
        ear_mid ox=-0.735 oy=0.185 scale=2.28905 @z=0.306 @sx=0.2769 @sy=0.4799 @sz=0.767
          ear_tip ox=-0.075 oy=0.005 scale=0.1798 @z=0.528
    bridge ox=0.775 oy=-0.025 scale=0.1798 @sy=1.9937 @rot=28.8 @sz=0.8714
